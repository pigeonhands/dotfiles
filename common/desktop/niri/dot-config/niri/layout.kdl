// https://yalter.github.io/niri/Configuration:-Layout
layout {
    gaps 13

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 1.0
    }

    default-column-width { 
        proportion 0.5
    }

    focus-ring {
        width 6

        //active-color "#262b26"
        inactive-color "#505050"
        active-gradient from="#38213f88" to="#262b2688"  angle=45
    }

    shadow {
        on

        // By default, the shadow draws only around its window, and not behind it.
        // Uncomment this setting to make the shadow draw behind its window.
        //draw-behind-window true

        softness 30             // Softness controls the shadow blur radius.
        spread 5                // Spread expands the shadow.
        offset x=0 y=5          // Offset moves the shadow relative to the window.
        color "#0007"           // You can also change the shadow color and opacity.

    }

    // Struts shrink the area occupied by windows, similarly to layer-shell panels.
    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

