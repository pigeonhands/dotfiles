set -g @plugin "https://github.com/pigeonhands/gruvbox-tmux.git"

set -g @gruvbox-tmux_show_datetime 1
set -g @gruvbox-tmux_time_format 12H

set -g @gruvbox-tmux_theme "hard"
set -g @gruvbox-tmux_transparent 0


set -g @gruvbox-tmux_window_id_style dsquare  # hsquare | fsquare | sub | super | arabic | earabic
set -g @gruvbox-tmux_pane_id_style super      # hsquare | fsquare | sub | super | arabic | earabic
set -g @gruvbox-tmux_zoom_id_style rsquare    # hsquare | fsquare | sub | super | arabic | earabic


set -g @gruvbox-tmux_time_format "12H"
set -g @gruvbox-tmux_status_right ""

set -g @gruvbox-tmux_show_git 1

if-shell '[ "$SESSION_TYPE" = "remote/ssh" ]' {
    set -g @gruvbox-tmux_theme "light"
    set -g @gruvbox-tmux_window_id_style "dsquare"
    set -g @gruvbox-tmux_transparent 0
    set -g status-position bottom

    set -g @my_ssh_status "#[fg=#{E:@gruvbox-tmux-theme_baqua},bg=#{E:@gruvbox-tmux-theme_black}]#{E:@gruvbox-tmux-seperator} #(echo \"\$SSH_CONNECTION\" | awk '{ print \$1 \" » \" \$3\":\"\$4 }') "

    set -ag @gruvbox-tmux_status_right "#{E:@my_ssh_status}"
}

set -g @gruvbox-tmux_status_right "#{E:@gruvbox-tmux_status_git}#{E:@gruvbox-tmux_status_wb_git}"
set -ag @gruvbox-tmux_status_right "#{E:@gruvbox-tmux_status_datetime}"
